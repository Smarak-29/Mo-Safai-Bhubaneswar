<%- include('partials/header') %>

<div class="space-y-8 max-w-6xl mx-auto">

  <!-- Hero Civic Banner -->
  <div class="relative bg-gradient-to-br from-civic-900 via-civic-800 to-emerald-950 text-white rounded-3xl p-6 sm:p-10 shadow-lg border border-civic-700/40 overflow-hidden">
    <!-- Subtle background watermarking -->
    <div class="absolute -right-12 -bottom-12 text-white/5 pointer-events-none">
      <i data-lucide="recycle" class="w-72 h-72"></i>
    </div>

    <div class="relative z-10 max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase">
        <i data-lucide="shield-check" class="w-3.5 h-3.5 text-amber-300"></i>
        <span>BMC Swachh Survekshan 2026 Initiative</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight font-sans" data-i18n="landing_hero_title">
        AI Smart Waste Management & Dual-Stream Routing
      </h1>

      <p class="text-sm sm:text-base text-emerald-100/90 leading-relaxed font-normal" data-i18n="landing_hero_desc">
        Empowering 1+ million citizens across 67 BMC wards with Gemini Vision waste classification, Mo Khata bio-composting, and Haversine truck route optimization.
      </p>

      <!-- Action Buttons -->
      <div class="pt-2 flex flex-wrap items-center gap-3">
        <a href="/scanner" class="touch-target inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-bold text-sm px-5 py-3 rounded-xl shadow-md transition-all">
          <i data-lucide="scan" class="w-4 h-4"></i>
          <span data-i18n="btn_launch_scanner">Launch AI Scanner</span>
        </a>

        <a href="/map" class="touch-target inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 active:bg-white/30 text-white border border-white/20 font-bold text-sm px-5 py-3 rounded-xl backdrop-blur-xs transition-all">
          <i data-lucide="map" class="w-4 h-4 text-emerald-300"></i>
          <span data-i18n="btn_open_map">Open Command Map</span>
        </a>

        <% if (!user) { %>
          <a href="/auth/demo-login" class="touch-target inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 active:bg-amber-600 text-slate-950 font-bold text-sm px-4 py-3 rounded-xl shadow-sm transition-all">
            <i data-lucide="zap" class="w-4 h-4 fill-slate-950"></i>
            <span data-i18n="demo_btn">⚡ Demo Citizen Login</span>
          </a>
        <% } else { %>
          <a href="/account" class="touch-target inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold text-sm px-4 py-3 rounded-xl transition-all">
            <i data-lucide="user-check" class="w-4 h-4 text-amber-300"></i>
            <span data-i18n="nav_account">Citizen Account</span>
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Live Civic Impact Cards (Stage 4) -->
  <div class="space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-surface-border pb-3">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="activity" class="w-5 h-5 text-civic-700"></i>
          <span data-i18n="civic_impact_heading">Live Municipal Civic Impact</span>
        </h2>
        <p class="text-xs text-slate-500 mt-0.5" data-i18n="civic_impact_desc">
          Real-time environmental telemetry aggregated from 12 IoT smart bins and citizen reports across Bhubaneswar
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 text-xs text-emerald-800 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full font-bold">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>BMC Telemetry Active</span>
        </span>
      </div>
    </div>

    <!-- 4 Impact Metric Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
      
      <!-- Card 1: Total AI Scans -->
      <div class="bg-white rounded-2xl border border-surface-border p-4 sm:p-5 shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500" data-i18n="stat_total_scans">Total AI Scans</span>
          <div class="w-8 h-8 rounded-xl bg-emerald-50 text-civic-700 flex items-center justify-center">
            <i data-lucide="scan-line" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl sm:text-3xl font-extrabold text-slate-900"><%= metrics.totalScans %></span>
          <span class="text-xs text-emerald-700 font-semibold">+100% Verified</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-1">
          <%= metrics.wetScans %> Wet • <%= metrics.dryScans %> Dry • <%= metrics.templeScans %> Temple
        </p>
      </div>

      <!-- Card 2: Mo Khata Bio-Compost -->
      <div class="bg-white rounded-2xl border border-surface-border p-4 sm:p-5 shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500" data-i18n="stat_mo_khata">Mo Khata Bio-Compost</span>
          <div class="w-8 h-8 rounded-xl bg-purple-50 text-purple-700 flex items-center justify-center">
            <i data-lucide="sprout" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl sm:text-3xl font-extrabold text-slate-900"><%= metrics.compostKg %> kg</span>
          <span class="text-xs text-purple-700 font-semibold">Mo Khata</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-1">
          Diverted to Niladri Vihar MCC
        </p>
      </div>

      <!-- Card 3: Fuel & CO2 Saved -->
      <div class="bg-white rounded-2xl border border-surface-border p-4 sm:p-5 shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500" data-i18n="stat_fuel_saved">Fuel & CO₂ Prevented</span>
          <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center">
            <i data-lucide="fuel" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-xl sm:text-2xl font-extrabold text-slate-900"><%= metrics.fuelSavedL %> L</span>
          <span class="text-xs text-amber-700 font-semibold">(<%= metrics.co2SavedKg %> kg CO₂)</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-1">
          Via Haversine Route Optimizer
        </p>
      </div>

      <!-- Card 4: Active BMC 1929 Tickets -->
      <div class="bg-white rounded-2xl border border-surface-border p-4 sm:p-5 shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500" data-i18n="stat_active_tickets">Active 1929 Complaints</span>
          <div class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
            <i data-lucide="alert-circle" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl sm:text-3xl font-extrabold text-slate-900"><%= metrics.activeTickets %></span>
          <span class="text-xs text-slate-500 font-medium">(<%= metrics.resolvedTickets %> Resolved)</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-1">
          Rapid truck clearance protocol
        </p>
      </div>

    </div>
  </div>

  <!-- Top Clean Wards Leaderboard (Stage 4) -->
  <div class="bg-white rounded-3xl border border-surface-border p-5 sm:p-7 shadow-sm space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
      <div>
        <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="trophy" class="w-5 h-5 text-amber-500"></i>
          <span data-i18n="leaderboard_heading">Top Clean Wards Leaderboard</span>
        </h2>
        <p class="text-xs text-slate-500 mt-0.5" data-i18n="leaderboard_desc">
          Live ranking of Bhubaneswar wards based on smart bin health scores, citizen Green Credits, and rapid grievance resolution
        </p>
      </div>
      <span class="text-xs font-semibold text-slate-600 bg-slate-100 px-3 py-1 rounded-lg border border-slate-200 self-start sm:self-auto">
        Bhubaneswar Municipal Corporation (BMC)
      </span>
    </div>

    <!-- Responsive Leaderboard Cards / Table -->
    <div class="space-y-3">
      <% leaderboard.forEach((ward, index) => { %>
        <div class="p-3.5 sm:p-4 rounded-2xl border border-surface-border hover:border-emerald-300 bg-slate-50/50 hover:bg-emerald-50/20 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          
          <!-- Rank & Ward Name -->
          <div class="flex items-center gap-3.5">
            <div class="w-8 h-8 rounded-xl <%= index === 0 ? 'bg-amber-400 text-amber-950 font-black' : index === 1 ? 'bg-slate-200 text-slate-800 font-bold' : index === 2 ? 'bg-amber-200 text-amber-900 font-bold' : 'bg-slate-100 text-slate-600 font-semibold' %> flex items-center justify-center text-xs flex-shrink-0 shadow-2xs">
              #<%= ward.rank %>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-bold text-slate-900"><%= ward.wardName %></h3>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full <%= ward.grade === 'A+' ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-blue-100 text-blue-800 border border-blue-200' %>">
                  Grade <%= ward.grade %>
                </span>
              </div>
              <p class="text-xs text-slate-500 mt-0.5">
                <%= ward.landmark %> • <%= ward.zone %> Zone • <%= ward.binCount %> Smart Bins
              </p>
            </div>
          </div>

          <!-- Cleanliness Score & Visual Bar -->
          <div class="flex items-center gap-4 sm:gap-6 justify-between sm:justify-end">
            <div class="w-28 sm:w-36">
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="text-[11px] font-medium text-slate-500" data-i18n="ward_score_col">Clean Score</span>
                <span class="font-bold text-slate-900"><%= ward.cleanScore %>/100</span>
              </div>
              <div class="w-full h-2 rounded-full bg-slate-200 overflow-hidden">
                <div 
                  class="h-full rounded-full <%= ward.cleanScore >= 85 ? 'bg-emerald-600' : ward.cleanScore >= 70 ? 'bg-blue-600' : 'bg-amber-500' %> transition-all duration-500" 
                  style="width: <%= ward.cleanScore %>%">
                </div>
              </div>
            </div>

            <span class="text-xs font-semibold px-2.5 py-1 rounded-lg <%= ward.cleanScore >= 85 ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-700 border border-slate-200' %> flex-shrink-0">
              <%= ward.status %>
            </span>
          </div>

        </div>
      <% }) %>
    </div>
  </div>

  <!-- Live BMC 1929 Grievance Reports Strip -->
  <div class="bg-white rounded-3xl border border-surface-border p-5 sm:p-7 shadow-sm space-y-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-xl bg-amber-50 text-terracotta-600 flex items-center justify-center">
          <i data-lucide="radio" class="w-4 h-4 text-terracotta-600 animate-pulse"></i>
        </div>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900" data-i18n="live_tickets_feed">
            Live BMC 1929 Citizen Tickets
          </h3>
          <p class="text-[11px] text-slate-400">Real-time civic alerts submitted via AI Waste Scanner</p>
        </div>
      </div>
      <a href="/map" class="text-xs font-semibold text-civic-700 hover:text-civic-800 flex items-center gap-1">
        <span>View on Map</span>
        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
      <% if (recentTickets && recentTickets.length > 0) { %>
        <% recentTickets.forEach(t => { %>
          <div class="p-3 rounded-xl border border-surface-border bg-slate-50/60 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-lg <%= t.status === 'Resolved' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-900' %> font-bold flex items-center justify-center flex-shrink-0">
                <i data-lucide="<%= t.status === 'Resolved' ? 'check' : 'alert-triangle' %>" class="w-3.5 h-3.5 <%= t.status === 'Resolved' ? 'text-emerald-700' : 'text-terracotta-600' %>"></i>
              </span>
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-mono font-bold text-slate-900"><%= t.ticketId || t.scanId %></span>
                  <span class="px-1.5 py-0.2 rounded text-[10px] font-bold <%= t.status === 'Resolved' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-900' %>">
                    <%= t.status === 'Resolved' ? 'RESOLVED' : 'DISPATCHED' %>
                  </span>
                </div>
                <p class="text-[11px] text-slate-500 mt-0.5"><%= t.wardName %> • <%= t.wasteCategory %></p>
              </div>
            </div>
            <span class="text-[11px] text-slate-400">
              <%= new Date(t.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
            </span>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-2 text-center py-4 text-xs text-slate-400" data-i18n="no_tickets_yet">
          No active overflow tickets recorded.
        </div>
      <% } %>
    </div>
  </div>

</div>

<%- include('partials/footer') %>
