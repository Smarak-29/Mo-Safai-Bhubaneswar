<%- include('partials/header') %>

<div class="max-w-md mx-auto space-y-6">

  <!-- Scanner Card -->
  <div class="bg-white rounded-2xl border border-surface-border p-6 shadow-sm text-center">
    
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-emerald-50 text-civic-700 border border-emerald-100 mb-4 shadow-xs">
      <i data-lucide="scan-line" class="w-8 h-8"></i>
    </div>

    <h1 class="text-xl font-bold tracking-tight text-slate-900" data-i18n="nav_scanner">
      Smart Scanner
    </h1>
    <p class="text-xs sm:text-sm text-slate-500 mt-1">
      BMC AI Computer Vision model identifies waste stream (Wet/Dry) and provides bilingual voice segregation guidance.
    </p>

    <!-- Camera Viewfinder Mockup (Anti-AI-slop, clean civic utility style) -->
    <div class="mt-6 aspect-[4/3] bg-slate-100 rounded-2xl border-2 border-dashed border-slate-300 flex flex-col items-center justify-center p-6 relative overflow-hidden group">
      <div class="w-12 h-12 rounded-xl bg-white shadow-sm flex items-center justify-center text-slate-400 mb-3 group-hover:scale-105 transition-transform">
        <i data-lucide="camera" class="w-6 h-6 text-civic-700"></i>
      </div>
      <p class="text-xs font-semibold text-slate-700">Point Camera at Waste Item</p>
      <p class="text-[11px] text-slate-400 mt-1 max-w-xs">Supports kitchen organics, plastics, coconut shells, paper, and medical waste.</p>
      
      <!-- Viewfinder corners -->
      <div class="absolute top-4 left-4 w-5 h-5 border-t-2 border-l-2 border-civic-700"></div>
      <div class="absolute top-4 right-4 w-5 h-5 border-t-2 border-r-2 border-civic-700"></div>
      <div class="absolute bottom-4 left-4 w-5 h-5 border-b-2 border-l-2 border-civic-700"></div>
      <div class="absolute bottom-4 right-4 w-5 h-5 border-b-2 border-r-2 border-civic-700"></div>
    </div>

    <!-- Quick segregation tip pills -->
    <div class="mt-6 grid grid-cols-2 gap-3 text-left">
      <div class="p-3 rounded-xl bg-emerald-50/80 border border-emerald-200">
        <div class="flex items-center gap-1.5 text-xs font-bold text-emerald-900">
          <i data-lucide="apple" class="w-3.5 h-3.5 text-emerald-700"></i>
          <span>Wet Waste (ଓଦା)</span>
        </div>
        <p class="text-[11px] text-emerald-800 mt-0.5">Vegetables, peels, cooked food, flowers.</p>
      </div>

      <div class="p-3 rounded-xl bg-blue-50/80 border border-blue-200">
        <div class="flex items-center gap-1.5 text-xs font-bold text-blue-900">
          <i data-lucide="box" class="w-3.5 h-3.5 text-blue-700"></i>
          <span>Dry Waste (ଶୁଖିଲା)</span>
        </div>
        <p class="text-[11px] text-blue-800 mt-0.5">Plastics, bottles, cardboard, metal cans.</p>
      </div>
    </div>

    <!-- City Map Quick Link -->
    <div class="mt-6">
      <a href="/map" class="touch-target w-full flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs sm:text-sm rounded-xl shadow-sm transition-all">
        <i data-lucide="map-pin" class="w-4 h-4"></i>
        <span>View Nearby Smart Bins on Map</span>
      </a>
    </div>

  </div>

</div>

<%- include('partials/footer') %>
